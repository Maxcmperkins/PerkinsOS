# The boot splash, in Plymouth's own script language. Plymouth calls the
# functions given to it at the bottom.

Window.SetBackgroundTopColor(0.005, 0.025, 0.012);
Window.SetBackgroundBottomColor(0.005, 0.025, 0.012);

middle_x = Window.GetX() + Window.GetWidth() / 2;
middle_y = Window.GetY() + Window.GetHeight() / 2 - 40;

radar.image = Image("radar.png");
radar.sprite = Sprite(radar.image);
radar.sprite.SetX(middle_x - radar.image.GetWidth() / 2);
radar.sprite.SetY(middle_y - radar.image.GetHeight() / 2);

title.image = Image("title.png");
title.sprite = Sprite(title.image);
title.sprite.SetX(middle_x - title.image.GetWidth() / 2);
title.sprite.SetY(middle_y + radar.image.GetHeight() / 2 + 40);

# The beam turned to each of 72 directions, made once: turning a picture is
# too slow to do for every frame.
steps = 72;
sweep.image = Image("sweep.png");
for (i = 0; i < steps; i++)
	beams[i] = sweep.image.Rotate(i * 2 * Math.Pi / steps);
sweep.sprite = Sprite();
sweep.sprite.SetX(middle_x - sweep.image.GetWidth() / 2);
sweep.sprite.SetY(middle_y - sweep.image.GetHeight() / 2);

frame = 0;
fun refresh() {
	# Called 50 times a second: one turn in about three seconds.
	frame++;
	sweep.sprite.SetImage(beams[Math.Int(frame / 2) % steps]);
}
Plymouth.SetRefreshFunction(refresh);

# An encrypted disk asks for its password here: a question (if Plymouth has
# its text plugin) and a square per letter typed.
prompt.sprite = Sprite();
dot.image = Image("dot.png");
fun password(text, count) {
	prompt.image = Image.Text(text, 0.2, 1.0, 0.4);
	prompt.sprite.SetImage(prompt.image);
	prompt.sprite.SetX(middle_x - prompt.image.GetWidth() / 2);
	prompt.sprite.SetY(title.sprite.GetY() + 80);
	prompt.sprite.SetOpacity(1);
	for (i = 0; i < 32 || dots[i]; i++) {
		if (i < count) {
			if (!dots[i]) {
				dots[i] = Sprite(dot.image);
			}
			dots[i].SetX(middle_x + (i - count / 2) * 18);
			dots[i].SetY(title.sprite.GetY() + 120);
			dots[i].SetOpacity(1);
		} else if (dots[i]) {
			dots[i].SetOpacity(0);
		}
	}
}
fun normal() {
	prompt.sprite.SetOpacity(0);
	for (i = 0; dots[i]; i++)
		dots[i].SetOpacity(0);
}
Plymouth.SetDisplayPasswordFunction(password);
Plymouth.SetDisplayNormalFunction(normal);
