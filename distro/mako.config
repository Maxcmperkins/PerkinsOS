# Notifications in the HUD's colours (shell/common/theme.h): phosphor
# green on near-black, in the same monospace font. Format: man 5 mako.
font=DejaVu Sans Mono 11
background-color=#040F08E6
text-color=#33FF66
border-color=#33FF66
border-size=2
border-radius=0
padding=10
margin=12
width=360
anchor=top-right
default-timeout=6000
# Lower-priority messages in the dimmer green.
[urgency=low]
border-color=#177330
text-color=#177330
[urgency=critical]
default-timeout=0
