#!/bin/sh
# Start the PerkinsOS desktop on an ordinary Linux distro.
#
# Run it from a text console login (a "tty"), not from inside another
# desktop. On the Buildroot image this job is done by the init script
# /etc/init.d/S99desktop; on a distro the login system has already set up
# the things that script does by hand (XDG_RUNTIME_DIR, the locale, and
# permission to use the screen and input devices).

# Draw on the CPU, as the Buildroot image does (see its
# /etc/profile.d/perkinsos.sh). Set WLR_RENDERER=gles2 before running this
# to try the graphics card instead.
export WLR_RENDERER="${WLR_RENDERER:-pixman}"
# Draw the cursor into the frame, so it shows in QEMU screenshots.
export WLR_NO_HARDWARE_CURSORS=1
# Ask toolkits to use Wayland rather than look for an X11 server.
export MOZ_ENABLE_WAYLAND=1
export QT_QPA_PLATFORM=wayland
export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=PerkinsOS
# Look for settings in PerkinsOS's folder before the system's: foot's
# colours are there. (@PREFIX@ is filled in when this is installed.)
export XDG_CONFIG_DIRS="@PREFIX@/share/perkinsos/xdg:${XDG_CONFIG_DIRS:-/etc/xdg}"

LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}"
mkdir -p "$LOG_DIR"
# -s CMD: a command the compositor runs once it is ready (the wallpaper
# and the dock).
perkinsos-compositor -s perkinsos-session > "$LOG_DIR/perkinsos-desktop.log" 2>&1
# The compositor has exited: the desktop session is over.
systemctl --user stop perkinsos-session.target 2> /dev/null
