# The lock screen in the HUD's colours (shell/common/theme.h). Each line is
# one of swaylock's options (man swaylock) without the leading dashes.
color=010603
font=VT323
font-size=28
indicator-radius=110
indicator-thickness=6
indicator-idle-visible
show-failed-attempts
ignore-empty-password
inside-color=040f08
inside-clear-color=040f08
inside-ver-color=040f08
inside-wrong-color=040f08
ring-color=177330
ring-clear-color=ccdd44
ring-ver-color=33ff66
ring-wrong-color=ff5544
key-hl-color=33ff66
bs-hl-color=ff5544
line-color=00000000
line-clear-color=00000000
line-ver-color=00000000
line-wrong-color=00000000
separator-color=00000000
text-color=33ff66
text-clear-color=ccdd44
text-ver-color=33ff66
text-wrong-color=ff5544
