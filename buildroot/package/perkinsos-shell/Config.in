config BR2_PACKAGE_PERKINSOS_SHELL
	bool "perkinsos-shell"
	depends on BR2_PACKAGE_WLROOTS # layer-shell protocol XML
	select BR2_PACKAGE_WAYLAND
	select BR2_PACKAGE_WAYLAND_PROTOCOLS
	select BR2_PACKAGE_LIBXKBCOMMON
	select BR2_PACKAGE_CAIRO
	select BR2_PACKAGE_CAIRO_PNG
	help
	  The PerkinsOS dock, launcher and apps, built from the shell/
	  folder at the top of this repository. Every folder shell/NAME/
	  becomes the program /usr/bin/perkinsos-NAME.

comment "perkinsos-shell needs wlroots"
	depends on !BR2_PACKAGE_WLROOTS
