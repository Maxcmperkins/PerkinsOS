# PerkinsOS image config. Based on Buildroot's qemu_x86_64_defconfig.
# Only options that differ from Buildroot's defaults are listed.
# Change it with `make menuconfig`, then `make savedefconfig` (which
# rewrites this file and drops the comments, so re-add what matters).

# Target: 64-bit x86, generic CPU so it runs on any QEMU -cpu setting.
BR2_x86_64=y

# Toolchain: prebuilt GCC + glibc from Bootlin instead of compiling our own.
# Saves ~20 min per clean build. glibc because Mesa and wlroots are tested
# most on it. Includes C++, which Mesa needs in week 2.
BR2_TOOLCHAIN_EXTERNAL=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN=y
BR2_TOOLCHAIN_EXTERNAL_BOOTLIN_X86_64_GLIBC_STABLE=y

# Fail the build if any download has no known hash. The hash for our pinned
# kernel version lives in Buildroot's board/qemu/patches/linux/linux.hash.
# (Path is relative to the Buildroot tree.)
BR2_GLOBAL_PATCH_DIR="board/qemu/patches"
BR2_DOWNLOAD_FORCE_CHECK_HASHES=y

# System: BusyBox init (the default). Hostname and banner shown at login.
# Root has an empty password: this is a dev VM, and CI must log in unattended.
BR2_TARGET_GENERIC_HOSTNAME="perkinsos"
BR2_TARGET_GENERIC_ISSUE="Welcome to PerkinsOS"
# Generate one UTF-8 locale. Without any, programs only get the plain "C"
# locale and the foot terminal refuses to start. LANG is set in the overlay.
BR2_GENERATE_LOCALE="en_US.UTF-8"
# Bring up the virtio network card with DHCP (QEMU's user-mode network).
BR2_SYSTEM_DHCP="eth0"

# Kernel: pinned version, with Buildroot's known-good QEMU config.
# That config already has virtio disk/net, serial console and virtio-gpu.
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="6.18.7"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="board/qemu/x86_64/linux.config"
BR2_LINUX_KERNEL_NEEDS_HOST_LIBELF=y

# /dev is managed by eudev rather than the kernel's bare devtmpfs.
# libinput and wlroots find keyboards, mice and GPUs through udev.
BR2_ROOTFS_DEVICE_CREATION_DYNAMIC_EUDEV=y

# Our own files copied over the root filesystem (see buildroot/overlay/).
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_PERKINSOS_PATH)/overlay"

# Mesa: provides EGL, OpenGL ES and GBM, which Buildroot's wlroots package
# requires. virgl is the driver for QEMU's virtio-gpu and needs no LLVM,
# which keeps the build short. Selecting it turns on EGL and GBM.
BR2_PACKAGE_MESA3D=y
BR2_PACKAGE_MESA3D_GALLIUM_DRIVER_VIRGL=y
BR2_PACKAGE_MESA3D_OPENGL_ES=y

# wlroots 0.19.2 (pinned by the Buildroot release). Pulls in libinput,
# libdrm, libxkbcommon, pixman, seatd and wayland.
BR2_PACKAGE_WLROOTS=y
# Keyboard layout data; libxkbcommon can't build a keymap without it.
BR2_PACKAGE_XKEYBOARD_CONFIG=y

# Stock TinyWL from the same wlroots tarball (buildroot/package/tinywl/).
BR2_PACKAGE_TINYWL=y

# Our own code, built from compositor/ and shell/ at the top of the repo
# (buildroot/package/perkinsos-*). Both build nothing while those folders
# hold only a README. The shell package also pulls in cairo for drawing.
BR2_PACKAGE_PERKINSOS_COMPOSITOR=y
BR2_PACKAGE_PERKINSOS_SHELL=y

# A Wayland terminal to have something to open, and a font for it.
BR2_PACKAGE_FOOT=y
BR2_PACKAGE_DEJAVU=y
# wayland-info: lists the protocols the running compositor offers.
# Used in docs/WEEK4.md to check layer-shell is advertised.
BR2_PACKAGE_WAYLAND_UTILS=y

# Root filesystem: one ext4 image, attached to QEMU as a virtio disk.
# No tarball; nothing uses it. 256M leaves room for Mesa and our own apps.
BR2_TARGET_ROOTFS_EXT2=y
BR2_TARGET_ROOTFS_EXT2_4=y
BR2_TARGET_ROOTFS_EXT2_SIZE="256M"
# BR2_TARGET_ROOTFS_TAR is not set
